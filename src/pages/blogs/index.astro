---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Best Foot Forward — Charlie Kerfoot">
  <p class="nav"><a href="/">&larr; Home</a></p>

  <h1 class="title">Best Foot Forward</h1>
  <p>Occasional writing. Observations on life, in pursuit of eudaimonia.</p>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blogs/${post.id}/`}>{post.data.title}</a>
        <span class="date">&mdash; {fmt(post.data.date)}</span>
        {post.data.description && <div class="desc">{post.data.description}</div>}
      </li>
    ))}
  </ul>
</Base>
